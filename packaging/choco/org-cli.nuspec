<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>org-cli</id>
    <version>@@VERSION@@</version>
    <title>org-cli</title>
    <authors>dcprevere</authors>
    <projectUrl>https://github.com/dcprevere/org-cli</projectUrl>

    <tags>org-mode org-roam cli emacs</tags>
    <summary>Standalone Org notes and task management for humans and agents</summary>
    <description>org-cli manages and searches Org files with a rebuildable index, shared task workflows, an optional browser board and API, MCP, and an org-roam extension.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
