<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DefineConstants Condition="'$(EnableRoam)' != 'false'">$(DefineConstants);ROAM</DefineConstants>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>org</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>org</ToolCommandName>
    <PackageId>OrgCli</PackageId>
    <Description>Standalone Org CLI with an owned search index and optional org-roam support</Description>
    <Authors>dcprevere</Authors>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PackageProjectUrl>https://github.com/dcprevere/org-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dcprevere/org-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>org-mode;org-roam;cli;emacs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="dashboard.html" LogicalName="OrgCli.dashboard.html" />
  </ItemGroup>

  <ItemGroup>

    <Compile Include="Version.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="TaskCommands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <ProjectReference Include="../OrgCli.Roam.Extension/OrgCli.Roam.Extension.fsproj" Condition="'$(EnableRoam)' != 'false'" />
    <ProjectReference Include="..\OrgCli.Index\OrgCli.Index.fsproj" />
  </ItemGroup>

</Project>
